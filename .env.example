DATABASE_URL=postgres://appunions:appunions@localhost:55432/appunions
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
COOKIE_SECURE=false
API_PORT=3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=appunions
S3_PUBLIC_URL=http://localhost:9000/appunions
# 未配置 SendCloud 时，本地接口会在响应里带回验证码，方便试用
AUTH_ECHO_CODE=true
# SendCloud：https://www.sendcloud.net/ 控制台里的 API_USER / API_KEY，以及已验证发信地址
# SENDCLOUD_API_USER=
# SENDCLOUD_API_KEY=
# SENDCLOUD_FROM=noreply@your-domain.com
# SENDCLOUD_FROM_NAME=AppUnions
