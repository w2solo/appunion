# 1Panel 反代到本机这个端口（不要用 80/443，留给 1Panel）
PUBLISH_PORT=18080
TZ=Asia/Shanghai

POSTGRES_USER=appunions
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=appunions

JWT_SECRET=CHANGE_ME
# 走 1Panel HTTPS 时保持 true；若先用 http://IP:端口 试，临时改成 false
COOKIE_SECURE=true
# 生产务必 false。没配发信时，验证码只出现在 api 容器日志里
AUTH_ECHO_CODE=false

# 生产默认把图标落到本地磁盘，由 /media/icons 提供，不必再单独暴露对象存储
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_BUCKET=appunions
S3_PUBLIC_URL=http://127.0.0.1:9000/appunions

# 登录验证码走 SendCloud。不填则只能看 api 日志拿验证码
SENDCLOUD_API_USER=
SENDCLOUD_API_KEY=
SENDCLOUD_FROM=
SENDCLOUD_FROM_NAME=AppUnions
