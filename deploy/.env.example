# 1Panel 反代到本机这个端口（不要用 80/443，留给 1Panel）
PUBLISH_PORT=18080
TZ=Asia/Shanghai

POSTGRES_USER=appunions
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=appunions

JWT_SECRET=CHANGE_ME
# 走 1Panel HTTPS 时保持 true；若先用 http://IP:端口 试，临时改成 false
COOKIE_SECURE=true
# 生产务必 false。没配发信时，验证码只出现在 api 容器日志里
AUTH_ECHO_CODE=false

# 超管登录邮箱。不填则不会 seed 超管账号
SUPER_ADMIN_EMAIL=

# 可选，调 /internal 定时接口用
# CRON_SECRET=

# 登录验证码走 SendCloud。不填则只能看 api 日志拿验证码
SENDCLOUD_API_USER=
SENDCLOUD_API_KEY=
SENDCLOUD_FROM=
SENDCLOUD_FROM_NAME=AppUnions
