{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "appunions",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/dashboard/*", "/admin/*", "/health", "/media/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "COOKIE_SECURE": "true",
    "AUTH_ECHO_CODE": "false",
    "SENDCLOUD_FROM_NAME": "AppUnions"
  },
  "kv_namespaces": [
    { "binding": "KV", "id": "58229934daa744e8bc86f36ef26956e7" }
  ],
  "r2_buckets": [
    { "binding": "ICONS", "bucket_name": "appunions-icons" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appunions",
      "database_id": "5844f99a-929c-47f9-80be-af38d8dceb67",
      "migrations_dir": "packages/db/migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "0 */6 * * *", "15 0 * * *"]
  }
}
